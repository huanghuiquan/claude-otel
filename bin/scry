#!/usr/bin/env python3
"""scry — local service for viewing Claude Code OTel raw API bodies.

Usage:
  scry                          serve $PWD/.claude-otel on http://127.0.0.1:47821
  scry ~/some/logs              custom log root
  scry --port 8000              custom port
  scry --no-open                don't auto-open browser
"""
from __future__ import annotations
import argparse
import http.server
import json
import os
import re
import socketserver
import sys
import threading
import time
import urllib.parse
import webbrowser
from pathlib import Path

DEFAULT_PORT = 47821
DEFAULT_ROOT = ".claude-otel"


def discover_viewer() -> Path | None:
    here = Path(__file__).resolve().parent
    candidates = [
        here / "viewer.html",                            # alongside script
        here.parent / "viewer.html",                     # repo: bin/scry → ../viewer.html
        here / "claude-log-viewer.html",                 # legacy
        here.parent / "share" / "scry" / "viewer.html",
        Path.home() / ".local" / "share" / "scry" / "viewer.html",
    ]
    for c in candidates:
        if c.is_file():
            return c
    return None


def session_summary(d: Path) -> dict | None:
    files = sorted(d.glob("*.json"), key=lambda x: x.stat().st_mtime)
    if not files:
        return None
    reqs = [f for f in files if f.name.endswith(".request.json")]
    resps = [f for f in files if f.name.endswith(".response.json")]
    if not reqs and not resps:
        return None
    mtimes = [f.stat().st_mtime for f in files]
    return {
        "name": d.name,
        "turns": max(len(reqs), len(resps)),
        "requests": len(reqs),
        "responses": len(resps),
        "files": len(files),
        "first": min(mtimes),
        "last": max(mtimes),
        "size": sum(f.stat().st_size for f in files),
    }


def list_sessions(root: Path) -> list[dict]:
    out = []
    if not root.is_dir():
        return out
    for d in sorted(root.iterdir()):
        if not d.is_dir():
            continue
        s = session_summary(d)
        if s:
            out.append(s)
    out.sort(key=lambda s: s["last"], reverse=True)
    return out


def file_descriptor(f: Path) -> dict:
    name = f.name
    if name.endswith(".request.json"):
        kind = "request"
    elif name.endswith(".response.json"):
        kind = "response"
    else:
        kind = "other"
    st = f.stat()
    return {"name": name, "kind": kind, "size": st.st_size, "mtime": st.st_mtime}


def list_files(session_dir: Path) -> list[dict]:
    files = sorted(session_dir.glob("*.json"), key=lambda f: f.stat().st_mtime)
    return [file_descriptor(f) for f in files if f.is_file()]


class Handler(http.server.BaseHTTPRequestHandler):
    log_root: Path = Path(".")
    html: bytes = b"<h1>viewer.html missing</h1>"

    server_version = "scry/0.1"
    sys_version = ""

    def log_message(self, *a, **kw):
        pass

    def _resolve_session(self, name: str) -> Path | None:
        d = (self.log_root / name).resolve()
        root_r = self.log_root.resolve()
        if not str(d).startswith(str(root_r)):
            return None
        if not d.is_dir():
            return None
        return d

    def _resolve_file(self, session_dir: Path, fname: str) -> Path | None:
        f = (session_dir / fname).resolve()
        if not str(f).startswith(str(session_dir.resolve())):
            return None
        if not f.is_file():
            return None
        return f

    def _send_bytes(self, data: bytes, ctype: str, status=200, extra=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        if extra:
            for k, v in extra.items():
                self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _send_json(self, obj, status=200):
        self._send_bytes(json.dumps(obj).encode("utf-8"),
                         "application/json; charset=utf-8", status)

    def _send_404(self, msg="not found"):
        self._send_json({"error": msg}, 404)

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        path = url.path

        if path in ("/", "/index.html"):
            return self._send_bytes(self.html, "text/html; charset=utf-8")

        if path == "/api/health":
            return self._send_json({"ok": True, "root": str(self.log_root)})

        if path == "/api/sessions":
            return self._send_json(list_sessions(self.log_root))

        m = re.match(r"^/api/sessions/([^/]+)/files$", path)
        if m:
            name = urllib.parse.unquote(m.group(1))
            d = self._resolve_session(name)
            if not d:
                return self._send_404("session not found")
            return self._send_json({"session": name, "files": list_files(d)})

        m = re.match(r"^/api/sessions/([^/]+)/file/([^/]+)$", path)
        if m:
            name = urllib.parse.unquote(m.group(1))
            fname = urllib.parse.unquote(m.group(2))
            d = self._resolve_session(name)
            if not d:
                return self._send_404("session not found")
            f = self._resolve_file(d, fname)
            if not f:
                return self._send_404("file not found")
            data = f.read_bytes()
            return self._send_bytes(
                data,
                "application/json; charset=utf-8",
                extra={"X-Mtime": str(f.stat().st_mtime)},
            )

        m = re.match(r"^/api/sessions/([^/]+)/events$", path)
        if m:
            name = urllib.parse.unquote(m.group(1))
            d = self._resolve_session(name)
            if not d:
                return self._send_404("session not found")
            return self._sse_loop(d)

        self._send_404()

    def _sse_loop(self, session_dir: Path, max_seconds: int = 1800):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("X-Accel-Buffering", "no")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        seen: dict[str, float] = {
            f.name: f.stat().st_mtime for f in session_dir.glob("*.json")
        }
        start = time.time()
        try:
            self.wfile.write(b": connected\n\n")
            self.wfile.flush()
            last_ping = start
            while time.time() - start < max_seconds:
                time.sleep(1.0)
                now = time.time()
                changed = []
                current = set()
                for f in session_dir.glob("*.json"):
                    current.add(f.name)
                    mt = f.stat().st_mtime
                    if seen.get(f.name) != mt:
                        seen[f.name] = mt
                        changed.append(file_descriptor(f))
                # detect deletions (rare)
                gone = [n for n in seen if n not in current]
                for n in gone:
                    seen.pop(n, None)
                if changed:
                    payload = json.dumps({"changed": changed})
                    self.wfile.write(f"data: {payload}\n\n".encode())
                    self.wfile.flush()
                    last_ping = now
                elif now - last_ping > 15:
                    self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
                    last_ping = now
        except (BrokenPipeError, ConnectionResetError):
            return


class ThreadingServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    p = argparse.ArgumentParser(prog="scry",
        description="Local service for viewing Claude Code OTel raw API bodies.")
    p.add_argument("root", nargs="?",
                   default=os.environ.get("SCRY_ROOT", DEFAULT_ROOT),
                   help=f"log root containing session subdirs (default: ./{DEFAULT_ROOT})")
    p.add_argument("--port", type=int,
                   default=int(os.environ.get("SCRY_PORT", DEFAULT_PORT)),
                   help=f"port (default: {DEFAULT_PORT})")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--no-open", action="store_true",
                   help="don't auto-open browser")
    p.add_argument("--html", help="path to viewer.html (override auto-discovery)")
    args = p.parse_args()

    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        print(f"scry: log root not found: {root}", file=sys.stderr)
        print(f"  hint: run `claude-log` first to populate it.", file=sys.stderr)
        sys.exit(1)

    html_path = Path(args.html).expanduser().resolve() if args.html else discover_viewer()
    if not html_path or not html_path.is_file():
        print("scry: viewer.html not found.", file=sys.stderr)
        print("  expected one of:", file=sys.stderr)
        print(f"    {Path(__file__).resolve().parent}/claude-log-viewer.html", file=sys.stderr)
        print(f"    {Path.home()}/.local/share/scry/viewer.html", file=sys.stderr)
        print(f"    {Path.home()}/tmp/claude-log-viewer.html", file=sys.stderr)
        print("  or pass --html /path/to/viewer.html", file=sys.stderr)
        sys.exit(1)

    Handler.log_root = root
    Handler.html = html_path.read_bytes()

    srv = ThreadingServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{args.port}"
    print(f"scry  · root  {root}")
    print(f"      · html  {html_path}")
    print(f"      · serve {url}")
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nscry: bye")


if __name__ == "__main__":
    main()
